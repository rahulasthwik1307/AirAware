# ==============================================================================
# AirAware — Environment Variables Example Template
# ==============================================================================
# Security Notice:
# - NEVER commit real secrets or production credentials to source control.
# - Copy this file to .env.local and replace placeholders with your actual values.
# - All API credentials are strictly server-only (no NEXT_PUBLIC_ prefix).
# ==============================================================================

# OpenAQ v3 API Key (Ground Station In-Situ Telemetry)
# ------------------------------------------------------------------------------
# Server-only API key for querying real-time CPCB / official ground monitors in India
OPENAQ_API_KEY=your_openaq_api_key_here

# Cloudflare Workers AI Configuration (Strictly ₹0 Budget • Free Tier)
# ------------------------------------------------------------------------------
# Account identifier from Cloudflare dashboard
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API Token with "Workers AI: Run" permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Approved Cloudflare Workers AI Model Lineup (Verified Active Models)
CLOUDFLARE_AI_MODEL_PRIMARY=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_AI_MODEL_SECONDARY=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_AI_MODEL_TERTIARY=@cf/ibm-granite/granite-4.0-h-micro

# Optional: Secret used for signing stateless rate-limiting tokens (defaults to auto-generated secret)
# AIRAWARE_SESSION_SECRET=your_32_character_random_hex_secret_here
